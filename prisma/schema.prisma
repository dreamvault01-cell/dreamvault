generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  role      String   @default("USER") // USER or ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String
  shortDescription String?          // Shown on product cards
  price            Float            // Selling price (lowest variant price)
  compareAtPrice   Float?           // MRP / original price (for showing discount)
  image            String           // Primary image (hero)
  badge            String?
  status           String           @default("ACTIVE") // ACTIVE or DRAFT
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  tags             Tag[]            @relation("ProductTags")
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isRoomPreview Boolean @default(false) // Artwork-only image used in the illustrative room preview
  position  Int      @default(0) // For ordering images in gallery
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[] @relation("ProductTags")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String   // "A4", "A3", "A2", "A1"
  price          Float    // Selling price for this size
  compareAtPrice Float?   // MRP for this size
  sku            String?  // Stock Keeping Unit
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, size])
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  razorpayOrderId String?     @unique
  razorpayPaymentId String?
  status          String      @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED, CANCELLED
  totalAmount     Float
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingPin     String
  paymentMethod   String      @default("RAZORPAY") // RAZORPAY or COD
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float   // Store price at the time of purchase
  size      String? // Track which size was ordered
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(254)
  subject   String   @db.VarChar(150)
  message   String   @db.Text
  status    String   @default("NEW") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  lastMessageAt DateTime @default(now()) @db.Timestamptz(3)
  lastInboundAt DateTime @default(now()) @db.Timestamptz(3)
  lastReadAt DateTime? @db.Timestamptz(3)
  replyToken String? @unique @db.VarChar(48)
  source String @default("FORM") @db.VarChar(10)
  messages SupportMessage[]

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([lastMessageAt])
}

model SupportMessage {
  id String @id @default(uuid())
  ticketId String
  ticket ContactMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  direction String @db.VarChar(10)
  kind String @db.VarChar(20)
  body String @db.Text
  fromEmail String? @db.VarChar(254)
  fromName String? @db.VarChar(100)
  toEmail String? @db.VarChar(254)
  replyToEmail String? @db.VarChar(254)
  subject String @db.VarChar(200)
  authorId String?
  attachments Json @default("[]")
  deliveryStatus String @default("RECEIVED") @db.VarChar(16)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  firstAttemptAt DateTime? @db.Timestamptz(3)
  lockedUntil DateTime? @db.Timestamptz(3)
  lockToken String? @db.VarChar(36)
  providerEmailId String? @unique
  internetMessageId String? @db.VarChar(998)
  inReplyTo String? @db.VarChar(998)
  sentAt DateTime? @db.Timestamptz(3)
  providerEventAt DateTime? @db.Timestamptz(3)
  lastError String? @db.VarChar(300)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([ticketId, createdAt])
  @@index([deliveryStatus, nextAttemptAt])
}

model SupportWebhookEvent {
  id String @id
  eventType String @db.VarChar(80)
  providerEmailId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}
