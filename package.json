    "next": "16.3.8",
    "next-cloudinary": "^6.19.3",
    "next-themes": "^0.4.6",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.34.1"
  },
  "devDependencies": {
